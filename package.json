{
  "name": "fagliers-mma-site",
  "version": "1.0.0",
  "private": true,
  "description": "Faglier's Mixed Martial Arts website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "lint:html": "html-validate index.html",
    "test:a11y": "npm run lint:html && npm run build:css && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "html-validate": "^11.21.0",
    "tailwindcss": "^4.3.5"
  }
}
